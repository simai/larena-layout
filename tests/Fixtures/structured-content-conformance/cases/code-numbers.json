{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "code-numbers",
  "summary": "numbers true asks for line numbers.",
  "covers": [
    "content.code"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "k",
              "type": "content.code",
              "data": {
                "code": "a\nb"
              },
              "props": {
                "numbers": true
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><div class=\"sf-highlight\" data-sf-composition-id=\"k\"><pre><code data-lines>a\nb</code></pre></div></article>",
    "diagnostics": [],
    "assets": [
      "component/highlight"
    ]
  }
}
