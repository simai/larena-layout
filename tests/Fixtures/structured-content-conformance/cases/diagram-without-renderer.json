{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "diagram-without-renderer",
  "summary": "A diagram with no renderer registered: renderer_unavailable, nothing drawn, its assets named.",
  "covers": [
    "content.diagram"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "dg",
              "type": "content.diagram",
              "data": {
                "source": "graph LR\n  A --> B"
              },
              "props": {
                "engine": "mermaid",
                "title": "Flow"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"></article>",
    "diagnostics": [
      {
        "code": "renderer_unavailable",
        "path": "node:dg"
      }
    ],
    "assets": [
      "composition/diagram"
    ]
  }
}
