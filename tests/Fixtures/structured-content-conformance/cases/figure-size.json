{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "figure-size",
  "summary": "Width and height go on the image.",
  "covers": [
    "content.figure"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "f",
              "type": "content.figure",
              "data": {
                "src": "/images/a.webp",
                "alt": "A scene",
                "width": 1280,
                "height": 720
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><figure class=\"sf-figure\" data-sf-composition-id=\"f\"><div class=\"sf-figure-media\"><img src=\"/images/a.webp\" alt=\"A scene\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\"></div></figure></article>",
    "diagnostics": [],
    "assets": [
      "component/figure"
    ]
  }
}
