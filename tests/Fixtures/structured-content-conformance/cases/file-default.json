{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "file-default",
  "summary": "A file with only its address: the download icon, the name from the address, no size.",
  "covers": [
    "content.file"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "fl",
              "type": "content.file",
              "data": {
                "href": "https://cdn.example/files/Price%20list.xlsx?v=2#sheet"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><a class=\"sf-download-file\" href=\"https://cdn.example/files/Price%20list.xlsx?v=2#sheet\" download data-sf-composition-id=\"fl\"><span class=\"sf-download-file__body sf-download-file-wrap\"><span class=\"sf-download-file__main sf-download-file-container\"><i class=\"sf-download-file__icon sf-icon\" aria-hidden=\"true\">download</i><span class=\"sf-download-file__name sf-download-file-file-name\">Price list.xlsx</span></span></span></a></article>",
    "diagnostics": [],
    "assets": [
      "component/download-file"
    ]
  }
}
