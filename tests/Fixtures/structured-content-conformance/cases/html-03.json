        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "h",
              "type": "content.html",
              "data": {
                "markup": "loose <em>text</em>"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
