    "html": "<article data-sf-composition-id=\"root\"><p data-sf-composition-id=\"p\"><sf-button text=\"Open\" icon=\"open_in_new\" appearance=\"outlined\" scheme=\"primary\" size=\"1\"></sf-button></p></article>",
    "diagnostics": [],
    "assets": []
  }
}
