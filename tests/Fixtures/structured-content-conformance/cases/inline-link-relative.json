{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "inline-link-relative",
  "summary": "A relative link.",
  "covers": [
    "inline"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "p",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "link",
                    "href": "/docs/a?b=1&c=2",
                    "children": [
                      {
                        "type": "text",
                        "value": "docs"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><p data-sf-composition-id=\"p\"><a href=\"/docs/a?b=1&amp;c=2\">docs</a></p></article>",
    "diagnostics": [],
    "assets": []
  }
}
