{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "inline-text",
  "summary": "A text run is escaped text.",
  "covers": [
    "inline"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "p",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "a < b & c > d \"e\" 'f'"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><p data-sf-composition-id=\"p\">a &lt; b &amp; c &gt; d &quot;e&quot; &#39;f&#39;</p></article>",
    "diagnostics": [],
    "assets": []
  }
}
