{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "invalid-leaf-slots",
  "summary": "A leaf type holds no slots.",
  "covers": [
    "document"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "d",
              "type": "content.divider",
              "slots": {
                "default": []
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": false,
    "html": "",
    "diagnostics": [
      {
        "code": "leaf_slots_forbidden",
        "path": "$.root.slots.default[0].slots"
      },
      {
        "code": "slot_unknown",
        "path": "$.root.slots.default[0].slots.default"
      }
    ],
    "assets": []
  }
}
