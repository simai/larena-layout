{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "list-nested",
  "summary": "An item holds a nested list after its own line.",
  "covers": [
    "content.list-item"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "l",
              "type": "content.list",
              "slots": {
                "items": [
                  {
                    "id": "a",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "One"
                        }
                      ]
                    },
                    "slots": {
                      "default": [
                        {
                          "id": "n",
                          "type": "content.list",
                          "props": {
                            "ordered": true
                          },
                          "slots": {
                            "items": [
                              {
                                "id": "b",
                                "type": "content.list-item",
                                "data": {
                                  "content": [
                                    {
                                      "type": "text",
                                      "value": "Nested"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "c",
                    "type": "content.list-item",
                    "data": {
                      "content": [
                        {
                          "type": "text",
                          "value": "Two"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<article data-sf-composition-id=\"root\"><ul data-sf-composition-id=\"l\"><li data-sf-composition-id=\"a\">One<ol data-sf-composition-id=\"n\"><li data-sf-composition-id=\"b\">Nested</li></ol></li><li data-sf-composition-id=\"c\">Two</li></ul></article>",
    "diagnostics": [],
    "assets": []
  }
}
