{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "outlet-with-content",
  "summary": "A layout's outlet draws the page Document, and the page's assets join the layout's.",
  "covers": [
    "content.outlet"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "layout",
      "profile": "ui-layout",
      "root": {
        "id": "frame",
        "type": "layout.page",
        "slots": {
          "default": [
            {
              "id": "brand",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Brand"
                  }
                ]
              }
            },
            {
              "id": "o",
              "type": "content.outlet"
            }
          ]
        }
      }
    },
    "content": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "a",
              "type": "content.paragraph",
              "data": {
                "content": [
                  {
                    "type": "text",
                    "value": "Page text."
                  }
                ]
              }
            },
            {
              "id": "f",
              "type": "content.figure",
              "data": {
                "src": "/images/a.webp",
                "alt": "A scene"
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
    "valid": true,
    "html": "<main data-sf-composition-id=\"frame\"><p data-sf-composition-id=\"brand\">Brand</p><div data-sf-outlet=\"\" data-sf-composition-id=\"o\"><article data-sf-composition-id=\"root\"><p data-sf-composition-id=\"a\">Page text.</p><figure class=\"sf-figure\" data-sf-composition-id=\"f\"><div class=\"sf-figure-media\"><img src=\"/images/a.webp\" alt=\"A scene\" loading=\"lazy\" decoding=\"async\"></div></figure></article></div></main>",
    "diagnostics": [],
    "assets": [
      "component/figure"
    ]
  }
}
