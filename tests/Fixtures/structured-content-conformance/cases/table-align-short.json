        "slots": {
          "default": [
            {
              "id": "t",
              "type": "content.table",
              "data": {
                "rows": [
                  [
                    [
                      {
                        "type": "text",
                        "value": "Name"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "value": "Size"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "value": "Note"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "type": "text",
                        "value": "A"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "value": "1"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "value": "first",
                        "marks": [
                          "em"
                        ]
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "type": "text",
                        "value": "B"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "value": "2"
                      }
                    ],
                    [
                      {
                        "type": "link",
