    "html": "<article data-sf-composition-id=\"root\"><div class=\"table-frame\" data-sf-composition-id=\"t\"><table class=\"table\"><thead><tr><th scope=\"col\" style=\"text-align: end\">Name</th><th scope=\"col\">Size</th><th scope=\"col\">Note</th></tr></thead><tbody><tr><td style=\"text-align: end\">A</td><td>1</td><td><em>first</em></td></tr><tr><td style=\"text-align: end\">B</td><td>2</td><td><a href=\"/b\">second</a></td></tr></tbody></table></div></article>",
    "diagnostics": [],
    "assets": [
