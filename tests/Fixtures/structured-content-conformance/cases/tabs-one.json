{
  "schema": "simai.composition.structured-content-conformance-case",
  "schema_version": 1,
  "id": "tabs-one",
  "summary": "One tab: selected, its panel shown.",
  "covers": [
    "content.tab"
  ],
  "input": {
    "document": {
      "schema": "simai.composition.document",
      "schema_version": 1,
      "id": "page",
      "profile": "structured-content",
      "root": {
        "id": "root",
        "type": "content.document",
        "slots": {
          "default": [
            {
              "id": "tb",
              "type": "content.tabs",
              "slots": {
                "tabs": [
                  {
                    "id": "t1",
                    "type": "content.tab",
                    "data": {
                      "label": "Only"
                    },
                    "slots": {
                      "default": [
                        {
                          "id": "t1p",
                          "type": "content.paragraph",
                          "data": {
                            "content": [
                              {
                                "type": "text",
                                "value": "One."
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "expect": {
